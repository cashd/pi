{
  "name": "cashd-pi-agent",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.12.1",
  "workspaces": [
    "extensions/*"
  ],
  "scripts": {
    "check": "npm run build:extensions",
    "build:extensions": "npm run build:pi-agent-header && npm run build:quick-actions && npm run build:short-read-paths && npm run build:powerline",
    "build:pi-agent-header": "bun build extensions/pi-agent-header.ts --target=node --external=@earendil-works/pi-coding-agent --external=@earendil-works/pi-tui --external=@earendil-works/pi-ai --outfile=/tmp/pi-agent-header.js",
    "build:quick-actions": "bun build extensions/quick-actions.ts --target=node --external=@earendil-works/pi-coding-agent --external=@earendil-works/pi-tui --external=@earendil-works/pi-ai --outfile=/tmp/pi-agent-quick-actions.js",
    "build:short-read-paths": "bun build extensions/short-read-paths.ts --target=node --external=@earendil-works/pi-coding-agent --external=@earendil-works/pi-tui --external=@earendil-works/pi-ai --outfile=/tmp/pi-agent-short-read-paths.js",
    "build:powerline": "bun build extensions/cashd-powerline-footer/index.ts --target=node --external=@earendil-works/pi-coding-agent --external=@earendil-works/pi-tui --external=@earendil-works/pi-ai --outfile=/tmp/pi-agent-powerline.js"
  }
}
