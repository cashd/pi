{
  "$schema": "https://raw.githubusercontent.com/earendil-works/pi/main/packages/coding-agent/src/modes/interactive/theme/theme-schema.json",
  "name": "github-light",
  "vars": {
    "canvas": "#ffffff",
    "canvasSubtle": "#f6f8fa",
    "canvasInset": "#eff2f5",
    "fg": "#1f2328",
    "fgMuted": "#57606a",
    "fgSubtle": "#6e7781",
    "border": "#d0d7de",
    "borderMuted": "#d8dee4",
    "accent": "#0969da",
    "accentBright": "#218bff",
    "accentSubtle": "#ddf4ff",
    "success": "#1a7f37",
    "successSubtle": "#dafbe1",
    "danger": "#cf222e",
    "dangerSubtle": "#ffebe9",
    "attention": "#9a6700",
    "attentionSubtle": "#fff8c5",
    "done": "#8250df",
    "doneBright": "#a475f9",
    "doneSubtle": "#fbefff",
    "cyan": "#1b7c83",
    "cyanBright": "#3192aa",
    "orange": "#bc4c00"
  },
  "colors": {
    "accent": "accent",
    "border": "border",
    "borderAccent": "accent",
    "borderMuted": "borderMuted",
    "success": "success",
    "error": "danger",
    "warning": "attention",
    "muted": "fgMuted",
    "dim": "fgSubtle",
    "text": "fg",
    "thinkingText": "fgMuted",

    "selectedBg": "accentSubtle",
    "userMessageBg": "canvasSubtle",
    "userMessageText": "fg",
    "customMessageBg": "doneSubtle",
    "customMessageText": "fg",
    "customMessageLabel": "done",
    "toolPendingBg": "canvasSubtle",
    "toolSuccessBg": "successSubtle",
    "toolErrorBg": "dangerSubtle",
    "toolTitle": "fg",
    "toolOutput": "fgMuted",

    "mdHeading": "attention",
    "mdLink": "accent",
    "mdLinkUrl": "fgSubtle",
    "mdCode": "cyan",
    "mdCodeBlock": "fg",
    "mdCodeBlockBorder": "border",
    "mdQuote": "fgMuted",
    "mdQuoteBorder": "border",
    "mdHr": "borderMuted",
    "mdListBullet": "cyan",

    "toolDiffAdded": "success",
    "toolDiffRemoved": "danger",
    "toolDiffContext": "fgMuted",

    "syntaxComment": "fgSubtle",
    "syntaxKeyword": "danger",
    "syntaxFunction": "done",
    "syntaxVariable": "orange",
    "syntaxString": "#0a3069",
    "syntaxNumber": "#0550ae",
    "syntaxType": "success",
    "syntaxOperator": "danger",
    "syntaxPunctuation": "fgMuted",

    "thinkingOff": "borderMuted",
    "thinkingMinimal": "fgSubtle",
    "thinkingLow": "accent",
    "thinkingMedium": "cyan",
    "thinkingHigh": "done",
    "thinkingXhigh": "danger",

    "bashMode": "success"
